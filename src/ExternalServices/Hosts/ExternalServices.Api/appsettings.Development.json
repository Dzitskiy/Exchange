{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [
      "FromLogContext",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Debug"
      }
    ]
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "CreateOrderTopic": "create-order-topic",
    "OrderCreatedTopic": "order-created-topic",
    "ConsumerGroup": "producer-api-group"
  }
}